# Copy to `.env` and fill in values. Optional sections can stay absent.
# Project-owned boolean environment variables accept only 0 or 1.

# --- Durable ETL storage (PostgreSQL when DATABASE_URL is set; SQLite fallback) ---
# DATABASE_URL=postgresql://etl_user:change_me@localhost:5432/etl_s2t
# POSTGRES_SCHEMA=public
# POSTGRES_STATEMENT_TIMEOUT_MS=30000

# --- LLM (GigaChat по умолчанию; задайте LLM_PROVIDER для ollama/openrouter) ---
LLM_PROVIDER=gigachat
GIGACHAT_API_KEY=
GIGACHAT_MODEL=GigaChat
# Отдельные provider и модель LLM-as-judge. Provider по умолчанию совпадает
# с основным; override позволяет оценивать локальный Ollama через GigaChat.
# LLM_JUDGE_PROVIDER=gigachat
# По умолчанию для GigaChat judge используется GigaChat-2-Pro.
# GIGACHAT_JUDGE_MODEL=GigaChat-2-Pro
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=0
GIGACHAT_TIMEOUT=120

# --- Ollama (optional) ---
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# OLLAMA_TIMEOUT=120
# OLLAMA_TEMPERATURE=0
# OLLAMA_REASONING=0
# auto: text compatibility for deepseek-r1/llama3.1, native for other models
# OLLAMA_TOOL_CALL_MODE=auto

# --- Opt-in live tests and bounded E1–E5 experiments ---
# RUN_LIVE_AGENT_SCENARIOS=0
# LIVE_AGENT_LLM_JUDGE=0
# AGENT_RUN_METRICS_ENABLED=0
# LIVE_AGENT_DB_PATH=/absolute/path/to/excel_data.db
# HTTP deadline for one local ASGI /chat exchange (seconds, default: 300).
# LIVE_AGENT_HTTP_TIMEOUT=300
# 0 = counter-based fallback; 1 = typed observer capability expansion.
# WORKER_CAPABILITY_REROUTE_EXPERIMENT=0
# WORKER_SPLIT_TOOL_CALL_EXPERIMENT=0
# OPERATION_SQL_RISK_ASPECTS_EXPERIMENT=0
# S2T_NARROW_TOOLS_EXPERIMENT=0
# Prompt-only protocol variant used by the isolated operation matrix runner.
# OPERATION_SQL_RISK_PROTOCOL_EXPERIMENT=current
# Separate exact-scope pipeline for closed SQL-risk operations:
# 0 = off; 1 = internal LLM scope extraction + exact readers + neutral SQLGlot
# structure + internal LLM risk assessment/answer/display.
# The top router selects only the pipeline. This branch does not run ordinary
# downstream, workers, observer or upstream stages and never falls back to them.
# OPERATION_SQL_RISK_SCOPE_EVIDENCE_EXPERIMENT=0

# --- Excel header classifier ---
# CATBOOST_HEADER_MODEL_PATH=models/catboost_header_model.cbm

# --- Local embeddings (default pair is multilingual E5 + explicit E5 profile) ---
# Set both MODEL and PROFILE for any custom model; profiles are never guessed.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_MODEL_REVISION=
# EMBEDDING_PROFILE=multilingual-e5-v1

# --- Neo4j lineage (optional; NEO4J_USER is accepted as alias for NEO4J_USERNAME) ---
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change_me
# NEO4J_DATABASE=neo4j

# --- Langfuse tracing (optional) ---
# LANGFUSE_ENABLED=0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_TRACING_ENVIRONMENT=development

# --- FastAPI/ASGI runtime (optional) ---
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=8000
# UVICORN_RELOAD=0
# Deadline and bounded concurrency for one application process.
# CHAT_REQUEST_TIMEOUT=900
# LLM_TIMEOUT=120
# TOOL_TIMEOUT=120
# GigaChat defaults to 1; other providers default to 8.
# LLM_MAX_CONCURRENCY=1
# TOOL_MAX_CONCURRENCY=16
# Safe default is 1. Enable 4 only after a provider-specific live gate.
# WORKER_MAX_CONCURRENCY=1
# GIGACHAT_MAX_RETRIES=3
# GIGACHAT_RETRY_BACKOFF_FACTOR=1
# Legacy fallback used only when UVICORN_RELOAD is absent.
# FLASK_DEBUG=0
